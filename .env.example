AUDIO_BIND=0.0.0.0
AUDIO_PORT=8000
AUDIO_DOWNLOAD_ROOT=/app/downloads
AUDIO_STATE_ROOT=/app/data
AUDIO_ARCHIVE_ROOT=/app/archives
AUDIO_MAX_LOG_LINES=160
AUDIO_PASSWORD=change-this-before-public-hosting
AUDIO_SECURE_COOKIES=1

# Optional: spotDL can use your own Spotify developer application.
# SPOTIPY_CLIENT_ID=
# SPOTIPY_CLIENT_SECRET=
